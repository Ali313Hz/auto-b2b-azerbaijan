# Copy to .env.local for local development and set the same variables in
# Vercel (Project Settings -> Environment Variables). Never commit real values.

# Supabase project URL (Project Settings -> API). Public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key. Public; access is enforced by RLS/RPCs.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase secret (service role) key. SERVER ONLY. Used to create, update
# and delete customer login accounts. Must not have the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_xxx
